// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: config
//   Document: tunables
//     unitsPerSat, tapUnits, dailyTapCap, resetHourUtc, baseFillRate,
//     durationBoostSeconds, speedBoostAmount, speedBoostSeconds,
//     adCooldownSeconds, adsPerCycle, dailySatsEarnCap, minWithdrawSats
//
// Collection: users
//   Document: {uid}
//     createdAt
//   Subcollection: game / Document: state
//     progress, fillRate, autoFillUntil, speedBoostUntil, speedBoostAmount,
//     tapsRemaining, tapDay, adsUsed, satsEarnedToday, satsDay,
//     lastAdAt, lastTickAt, lastBoostType, satsBalance
//   Subcollection: ledger / Document: {id}
//     deltaSats, reason, meta, createdAt
//   Subcollection: withdrawals / Document: {id}
//     amountSats, bolt11, status, adminNote, createdAt, updatedAt
//   Subcollection: adEvents / Document: {eventId}
//     boostType, appliedAt
//
// Clients: authenticated read of own game/state + withdrawals only.
// All mutations via Cloud Functions (Admin SDK). Tunables: no client write.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /game/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /ledger/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /withdrawals/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /adEvents/{doc} {
        allow read: if false;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
